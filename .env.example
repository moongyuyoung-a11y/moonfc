# 배포 도메인 (canonical, sitemap, OG 이미지 절대경로에 사용)
NEXT_PUBLIC_SITE_URL=https://mcg.co.kr

# 상담 신청 폼 전송 엔드포인트 (Formspree, Web3Forms 등 정적 사이트용 폼 서비스 URL)
# 비워두면 폼 대신 카카오채널 / 이메일 안내만 노출됩니다.
NEXT_PUBLIC_FORM_ENDPOINT=

# 카카오톡 채널 URL (예: https://pf.kakao.com/_xxxxx)
NEXT_PUBLIC_KAKAO_CHANNEL_URL=

# 검색엔진 소유 확인 메타태그 값
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
